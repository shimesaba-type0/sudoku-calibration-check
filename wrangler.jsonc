{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sudoku-calibration-check",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Workers AI binding. Available as `env.AI` inside the Worker.
  "ai": {
    "binding": "AI"
  }
}
